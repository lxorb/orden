# Maintainer: Emil Vinu <101118850+lxorb@users.noreply.github.com>

pkgname=orden-bin
_pkgname=nib
pkgver=0.19.0
pkgrel=1
pkgdesc="Lightweight markdown editor with realtime inline preview"
arch=('x86_64' 'aarch64')
url="https://orden.so"
license=('AGPL-3.0-only')
depends=('gtk4>=4.14' 'nss' 'nspr' 'alsa-lib' 'libcups' 'at-spi2-core' 'libdrm' 'mesa'
         'libxkbcommon' 'libxcomposite' 'libxdamage' 'libxrandr' 'libxfixes' 'pango'
         'cairo' 'dbus' 'expat' 'hicolor-icon-theme')
optdepends=('pandoc: import and export DOCX, ODT, EPUB, LaTeX and friends'
            'xdg-utils: open links and attachments in the desktop default application')
provides=("orden=${pkgver}" "${_pkgname}=${pkgver}")
conflicts=("${_pkgname}" 'nib-bin' 'nibeditor')
options=('!strip' '!debug' '!emptydirs')

_url="https://github.com/lxorb/orden/releases/download/v${pkgver}"
source=('nib.desktop')
source_x86_64=("nib.deb::${_url}/Orden-${pkgver}-linux-x64.deb")
source_aarch64=("nib.deb::${_url}/Orden-${pkgver}-linux-arm64.deb")
noextract=('nib.deb')
sha256sums=('9275d5003e0f6d336c2159c3900e535512c6e9bf63309c2a7c85144b85902e63')
sha256sums_x86_64=('85d650bce50369991389368f6cecb080e8bb08db050d765cb075a751af67055b')
sha256sums_aarch64=('58e43657f7b36a01864b595d740f143aca75f4f19d518846944c28820d675839')

package() {
  bsdtar -O -xf "${srcdir}/nib.deb" 'data.tar.*' |
    bsdtar -xf - -C "${pkgdir}" usr
  if [ ! -e "${pkgdir}/usr/bin/orden" ]; then
    ln -s nib "${pkgdir}/usr/bin/orden"
  fi
  for one in "${pkgdir}"/usr/share/icons/hicolor/*/apps/nib.png; do
    if [ -f "$one" ] && [ ! -e "${one%/nib.png}/orden.png" ]; then
      mv "$one" "${one%/nib.png}/orden.png"
    fi
  done
  chmod 4755 "${pkgdir}/usr/share/Orden/chrome-sandbox"

  install -Dm644 "${srcdir}/nib.desktop" \
    "${pkgdir}/usr/share/applications/${_pkgname}.desktop"
  rm -f "${pkgdir}/usr/share/applications/Nib.desktop" \
    "${pkgdir}/usr/share/applications/nibeditor.desktop" \
    "${pkgdir}/usr/share/applications/Orden.desktop"

  install -Dm644 "${pkgdir}/usr/share/icons/hicolor/256x256@2/apps/orden.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/orden.png"
  rm -rf "${pkgdir}/usr/share/icons/hicolor/256x256@2"
}

