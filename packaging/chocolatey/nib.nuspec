<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>nib</id>
    <version>0.21.1</version>
    <packageSourceUrl>https://github.com/lxorb/orden/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>lxorb</owners>

    <title>[Deprecated] Orden</title>
    <authors>lxorb</authors>
    <projectUrl>https://orden.so</projectUrl>
    <copyright>Copyright (c) 2026 lxorb</copyright>
    <licenseUrl>https://github.com/lxorb/orden/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/lxorb/orden</projectSourceUrl>
    <docsUrl>https://github.com/lxorb/orden#readme</docsUrl>
    <bugTrackerUrl>https://github.com/lxorb/orden/issues</bugTrackerUrl>
    <tags>orden nib deprecated</tags>
    <summary>Renamed: Orden is the orden package now.</summary>
    <description><![CDATA[
This package is deprecated. Orden, formerly nibeditor, is published as
[orden](https://community.chocolatey.org/packages/orden) since 0.15.0.

Installing or upgrading `nib` installs `orden`, which upgrades Orden in place, with
its settings and notes where they were. `choco uninstall nib` afterwards removes this
empty package alone and leaves Orden installed.
]]></description>
    <dependencies>
      <dependency id="orden" version="0.21.1" />
    </dependencies>
  </metadata>
  <files />
</package>
