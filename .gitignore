node_modules/
dist/
# What a before-and-after measurement builds the other half into; see
# apps/desktop/test/e2e/first-paint.py.
dist-before/
dist-even/
target/
# What Tauri generates for the mobile targets. The Android project is source:
# its manifest, its theme and MainActivity are edited by hand, and the files
# gradle writes inside it are ignored by its own .gitignore. The Xcode project is
# not, because the CLI only writes it on a macOS machine and nothing in it is
# edited; the iOS job runs `tauri ios init` before it builds. The schemas beside
# them are written from the plugins on every build.
**/src-tauri/gen/*
!**/src-tauri/gen/android/
.svelte-kit/
.wrangler/
*.log
# What the end-to-end run photographs. Made fresh every time it runs; see
# apps/desktop/test/e2e/collaborate.py.
apps/desktop/test/e2e/shots/
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# What `evenhub pack` writes; see docs/even.md
*.ehpk

# Rust build output for the MCP connector
services/mcp/target/

# The MCP connector is staged here at build time
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# What the clipper's build packs for the Chrome Web Store, beside its dist
apps/clipper/*.zip

# Claude Code worktrees of this repo
.claude/worktrees/
*.nupkg

# What Python leaves behind when one drive imports another
__pycache__/
