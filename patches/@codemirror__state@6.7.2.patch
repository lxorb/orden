+// Ranges whose changes follow one another, each wholly after the one before and its range, are
+// joined in one pass: composing them one by one costs time that grows with their square.
+function changedInLine(state, results) {
+    let specs = [], ranges = [], delta = 0, last = -1;
+    for (let result of results) {
+        if (asArray(result.effects).length)
+            return null;
+        let set = state.changes(result.changes), range = result.range;
+        let lo = -1, hi = -1;
+        set.iterChangedRanges((fromA, toA) => { if (lo < 0)
+            lo = fromA; hi = toA; });
+        if (lo >= 0 && lo <= last)
+            return null;
+        if (range.from <= last)
+            return null;
+        set.iterChanges((fromA, toA, _fromB, _toB, insert) => specs.push({ from: fromA, to: toA, insert }));
+        let own = set.newLength - set.length;
+        ranges.push(delta ? range.map({ mapPos: pos => pos + delta }) : range);
+        let reach = lo < 0 || range.to < lo ? range.to : Math.max(hi, range.to - own);
+        last = Math.max(last, hi, reach);
+        delta += own;
+    }
+    return { changes: state.changes(specs), ranges };
+}
