{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nib-sync",
  "main": "src/machines/entry.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nib",
      "database_id": "3eb83f94-5361-4850-a256-28611a4f94a4",
      "migrations_dir": "migrations",
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "NoteRoom" },
      { "name": "HUB", "class_name": "AccountHub" },
      { "name": "MACHINES", "class_name": "Machine" },
      { "name": "CHATS", "class_name": "ChatLog" },
      { "name": "APPS", "class_name": "AppRelay" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountHub"] },
    { "tag": "v3", "new_sqlite_classes": ["Machine"] },
    { "tag": "v4", "new_sqlite_classes": ["ChatLog"] },
    { "tag": "v5", "new_sqlite_classes": ["AppRelay"] },
  ],

  "containers": [
    {
      "class_name": "Machine",
      "name": "nib-sync-machines",
      "scheduling_policy": "durable_object",
      "images": { "machine": { "dockerfile": "../machine/Dockerfile" } },
    },
  ],

  "r2_buckets": [
    { "binding": "NOTES", "bucket_name": "nib-notes" },
    { "binding": "HOMES", "bucket_name": "nib-homes", "jurisdiction": "eu" },
  ],

  "ai": { "binding": "AI" },

  "assets": {
    "directory": "../../apps/desktop/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"],
  },

  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "BLOG_ROOT": "orden.so",
    "BLOG_CNAME_TARGET": "cname.orden.so",
    "CF_ZONE_ID": "46c1a42759c6af60043e590f581544c0",
    "APP_ORIGIN": "https://orden.so",
    "OTHER_ORIGINS": "https://nibeditor.com",
    "OTHER_BLOG_ROOTS": "nibeditor.com",
    "MACHINE_DOMAIN": "nibeditor.com",
    "MAIL_FROM": "Orden <nib@nibeditor.com>",
    "FEEDBACK_REPO": "lxorb/orden-feedback",
    "FEEDBACK_PROJECT": "lxorb/2",
    "MACHINE_EGRESS": "open",
    "CF_ACCOUNT_ID": "b0e98c15b1f905a394ecd6a849e8e99f",
  },

  "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
  "routes": [
    { "pattern": "nibeditor.com/*", "zone_name": "nibeditor.com" },
    { "pattern": "*.nibeditor.com/*", "zone_name": "nibeditor.com" },
    { "pattern": "orden.so/*", "zone_name": "orden.so" },
    { "pattern": "*.orden.so/*", "zone_name": "orden.so" },
    { "pattern": "blog.emilvinu.ch/*", "zone_name": "emilvinu.ch" },
  ],
}
