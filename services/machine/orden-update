#!/bin/bash
# ordend as the Worker hands it out now, put in place before every start of ordend on a
# server of its own (ordend.service's ExecStartPre). The
# Worker serves the bundle it was deployed with and says its SHA-256; the bundle is
# fetched, checked against it, and its files installed (install.sh --files). Never in
# the way: anything that fails leaves the ordend that is there, and ordend starts.
set -euo pipefail
machine=/etc/orden/machine
[ -r "$machine" ] || machine=/etc/nib/machine
[ -r "$machine" ] || exit 0
# shellcheck source=/dev/null
. "$machine"
opt=/opt/ordend
[ ! -d "$opt" ] && [ -d /opt/nibd ] && opt=/opt/nibd
ORDEN_ORIGIN=${ORDEN_ORIGIN:-${NIB_ORIGIN:-}}
[ -n "$ORDEN_ORIGIN" ] || exit 0

sha=$(curl -fsS --max-time 10 "$ORDEN_ORIGIN/v2/online/machine/current" || true)
[[ "$sha" =~ ^[0-9a-f]{64}$ ]] || exit 0
[ "$sha" = "$(cat "$opt/bundle" 2>/dev/null || true)" ] && exit 0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl -fsS --max-time 120 -o "$work/machine.bin" "$ORDEN_ORIGIN/v2/online/machine/$sha.bin"
echo "$sha  $work/machine.bin" | sha256sum -c --quiet -
mkdir "$work/bundle"
tar -xzf "$work/machine.bin" -C "$work/bundle"
bash "$work/bundle/install.sh" --files
echo "$sha" >"$opt/bundle"
echo "orden-update: ordend is now ${sha:0:12}"
