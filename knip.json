{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js,mjs}"]
    },
    "packages/editor": {},
    "packages/glasses": {},
    "packages/markdown": {},
    "packages/rooms": {},
    "apps/desktop": {
      "entry": [
        "src/**/*.svelte",
        "index.html",
        "even.html",
        "src/even.ts",
        "presenter.html",
        "src/presenter.ts"
      ],
      "ignoreDependencies": ["katex", "axe-core"]
    },
    "apps/clipper": {
      "entry": [
        "src/**/*.svelte",
        "src/popup/main.ts",
        "src/options/main.ts",
        "src/background/index.ts",
        "src/content/index.ts",
        "vite.content.config.ts"
      ],
      "ignoreDependencies": ["@nib/themes"]
    },
    "services/sync": {},
    "packages/themes": {}
  }
}
