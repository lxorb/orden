<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_page"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/orden_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:text="@string/app_name" />

        <ImageView
            android:id="@+id/orden_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search"
            android:tint="@color/widget_text"
            android:contentDescription="@string/widget_search" />

        <ImageView
            android:id="@+id/orden_new"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_new"
            android:tint="@color/widget_text"
            android:contentDescription="@string/widget_new" />
    </LinearLayout>

    <TextView
        android:id="@+id/orden_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:textColor="@color/widget_muted"
        android:textSize="15sp"
        android:visibility="gone"
        android:text="@string/widget_empty" />

    <TextView
        android:id="@+id/orden_row_0"
        style="@style/OrdenWidgetRow" />

    <TextView
        android:id="@+id/orden_row_1"
        style="@style/OrdenWidgetRow" />

    <TextView
        android:id="@+id/orden_row_2"
        style="@style/OrdenWidgetRow" />
</LinearLayout>
