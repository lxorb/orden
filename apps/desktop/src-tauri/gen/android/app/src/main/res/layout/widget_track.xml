<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_page"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/orden_track_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:text="@string/widget_track" />

        <TextView
            android:id="@+id/orden_track_stop"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:text="@string/track_stop"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/orden_track_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:text="@string/widget_track_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/orden_track_cells"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/orden_track_cell_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/orden_track_cell_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/orden_track_cell_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/orden_track_cell_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/orden_track_cell_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/orden_track_cell_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/orden_track_cell_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/orden_track_cell_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:padding="4dp"
                android:textSize="13sp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
