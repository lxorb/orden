<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_page"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/orden_today_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:text="@string/widget_today" />

        <ImageView
            android:id="@+id/orden_today_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_new"
            android:tint="@color/widget_text"
            android:contentDescription="@string/widget_add_task" />
    </LinearLayout>

    <TextView
        android:id="@+id/orden_today_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:textColor="@color/widget_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/orden_today_row_0"
        style="@style/OrdenWidgetTask">

        <TextView
            android:id="@+id/orden_today_box_0"
            style="@style/OrdenWidgetBox" />

        <TextView
            android:id="@+id/orden_today_text_0"
            style="@style/OrdenWidgetTaskWords" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/orden_today_row_1"
        style="@style/OrdenWidgetTask">

        <TextView
            android:id="@+id/orden_today_box_1"
            style="@style/OrdenWidgetBox" />

        <TextView
            android:id="@+id/orden_today_text_1"
            style="@style/OrdenWidgetTaskWords" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/orden_today_row_2"
        style="@style/OrdenWidgetTask">

        <TextView
            android:id="@+id/orden_today_box_2"
            style="@style/OrdenWidgetBox" />

        <TextView
            android:id="@+id/orden_today_text_2"
            style="@style/OrdenWidgetTaskWords" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/orden_today_row_3"
        style="@style/OrdenWidgetTask">

        <TextView
            android:id="@+id/orden_today_box_3"
            style="@style/OrdenWidgetBox" />

        <TextView
            android:id="@+id/orden_today_text_3"
            style="@style/OrdenWidgetTaskWords" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/orden_today_row_4"
        style="@style/OrdenWidgetTask">

        <TextView
            android:id="@+id/orden_today_box_4"
            style="@style/OrdenWidgetBox" />

        <TextView
            android:id="@+id/orden_today_text_4"
            style="@style/OrdenWidgetTaskWords" />
    </LinearLayout>
</LinearLayout>
