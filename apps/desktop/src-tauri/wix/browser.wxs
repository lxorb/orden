<?xml version="1.0" encoding="utf-8"?>
<!-- Orden among the browsers, for an install from the MSI: the values the app writes
     for itself and the NSIS installer writes (crates/system/src/default_browser.rs holds this file
     to them), in the installing person's own hive, where Default apps reads them, and
     taken away again when the MSI is uninstalled.

     WiX reads this file as it is, so the product's name is written out: it is
     `productName` in tauri.conf.json, and the test holds the two together. The
     program is the file Tauri's own template calls `Path`.

     The ProgID was NibURL once. An install takes that key away, so nothing is left
     under a name no program answers to. The browser somebody chose under Default apps
     named that key, so the choice is made again. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="OrdenBrowser" Guid="{12BF5322-2EF3-4BA7-BB07-FC2F700B49CB}">
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden" Type="string" Value="Orden" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\shell\open\command" Type="string" Value="&quot;[!Path]&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities" Name="ApplicationName" Type="string" Value="Orden" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities" Name="ApplicationDescription" Type="string" Value="Notes and the web in one window." />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities\Startmenu" Name="StartMenuInternet" Type="string" Value="Orden" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities\URLAssociations" Name="http" Type="string" Value="OrdenURL" />
        <RegistryValue Root="HKCU" Key="Software\Clients\StartMenuInternet\Orden\Capabilities\URLAssociations" Name="https" Type="string" Value="OrdenURL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenURL" Type="string" Value="Orden URL" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenURL\Application" Name="ApplicationName" Type="string" Value="Orden" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenURL\Application" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenURL\DefaultIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenURL\shell\open\command" Type="string" Value="&quot;[!Path]&quot; --url &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="Orden" Type="string" Value="Software\Clients\StartMenuInternet\Orden\Capabilities" />
        <RemoveRegistryKey Id="OldUrlProgId" Root="HKCU" Key="Software\Classes\NibURL" Action="removeOnInstall" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
