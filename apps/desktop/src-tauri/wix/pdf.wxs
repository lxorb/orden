<?xml version="1.0" encoding="utf-8"?>
<!-- Orden among the programs "Open with" offers for a PDF, for an install from the
     MSI: the lines installer.nsh writes in ORDEN_PDF_OPEN_WITH (crates/documents/src/handed_pdfs.rs holds
     the two together), in the installing person's own hive, and taken away again when
     the MSI is uninstalled. The extension's own default is never written: the reader
     somebody chose for PDFs stays theirs.

     WiX reads this file as it is, so the product's name is written out: it is
     `productName` in tauri.conf.json, and the test holds the two together. The
     program is the file Tauri's own template calls `Path`. The ProgID was NibPDF once,
     and an install takes that key and its line in "Open with" away. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="OrdenPdf" Guid="{061D07B5-F824-4100-A584-CD711556B581}">
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenPDF" Type="string" Value="Orden PDF" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenPDF\Application" Name="ApplicationName" Type="string" Value="Orden" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenPDF\Application" Name="ApplicationIcon" Type="string" Value="[!Path],0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenPDF\DefaultIcon" Type="string" Value="[INSTALLDIR]documents\pdf.ico" />
        <RegistryValue Root="HKCU" Key="Software\Classes\OrdenPDF\shell\open\command" Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.pdf\OpenWithProgids" Name="OrdenPDF" Type="string" Value="" />
        <RemoveRegistryKey Id="OldPdfProgId" Root="HKCU" Key="Software\Classes\NibPDF" Action="removeOnInstall" />
        <RemoveRegistryValue Id="OldPdfOpenWith" Root="HKCU" Key="Software\Classes\.pdf\OpenWithProgids" Name="NibPDF" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
