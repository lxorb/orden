<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Orden</vendor>
  <vendor_url>https://orden.so</vendor_url>
  <action id="ch.emilvinu.nib.unlock">
    <description>Open what you protected in Orden</description>
    <message>Orden needs your password to open what you protected.</message>
    <icon_name>nib</icon_name>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
