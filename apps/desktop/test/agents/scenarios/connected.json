{
  "proves": "a client connected over MCP has Full permissions (#1099): it is told so, and its press on Place order goes through unasked, while the same press asks a sidebar agent (pay)",
  "steps": [
    {
      "call": "agent_status",
      "args": {},
      "expect": {
        "status": "ok",
        "contains": {
          "result.grant.mode": "autonomous",
          "result.grant.scopes": "terminal"
        }
      }
    },
    {
      "call": "browser_open",
      "args": {
        "url": "{site}/shop"
      },
      "save": {
        "tab": "result.tab"
      }
    },
    {
      "call": "browser_wait",
      "args": {
        "tab": "{tab}",
        "for": "load"
      }
    },
    {
      "call": "browser_find",
      "args": {
        "tab": "{tab}",
        "role": "button",
        "name": "Place order"
      },
      "expect": {
        "status": "ok",
        "has": ["result.matches.0.ref"]
      },
      "save": {
        "order": "result.matches.0.ref"
      }
    },
    {
      "call": "browser_click",
      "args": {
        "tab": "{tab}",
        "ref": "{order}"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "record": "order",
      "count": 1
    }
  ]
}
