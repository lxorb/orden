{
  "name": "nib",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @nib/desktop app",
    "web": "pnpm --filter @nib/desktop dev",
    "build": "pnpm --filter @nib/desktop app:build",
    "check": "pnpm -r --no-bail check",
    "test": "pnpm -r --no-bail --workspace-concurrency=2 test -- --maxWorkers=50%",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "blog:css": "node scripts/blog-css.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@evenrealities/pretext": "^0.1.4",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "comment": "workerd ships no win32-arm64 binary; pull the x64 one so wrangler runs under emulation.",
    "supportedArchitectures": {
      "os": [
        "current",
        "win32",
        "linux"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    }
  }
}
