{
  "name": "nib",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @nib/desktop app",
    "web": "pnpm --filter @nib/desktop dev",
    "build": "pnpm --filter @nib/desktop app:build",
    "check": "pnpm -r --no-bail check",
    "test": "pnpm -r --no-bail test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"],
    "comment": "workerd ships no win32-arm64 binary; pull the x64 one so wrangler runs under emulation.",
    "supportedArchitectures": {
      "os": ["current", "win32", "linux"],
      "cpu": ["current", "x64", "arm64"]
    }
  }
}
